# OpenAI API key (required)
OPENAI_API_KEY=

# LLM provider (default: ChatOpenAI)
# See https://python.langchain.com/docs/integrations/llms/ for supported providers
LLM_PROVIDER=ChatOpenAI

# Model used for fast operations (default: gpt-3.5-turbo-16k)
FAST_LLM_MODEL=gpt-3.5-turbo-16k

# Model used for smart/complex operations (default: gpt-4)
SMART_LLM_MODEL=gpt-4

# Token limits
FAST_TOKEN_LIMIT=4000
SMART_TOKEN_LIMIT=8000

# Max length of a single browsed chunk (default: 8192)
BROWSE_CHUNK_MAX_LENGTH=8192

# Sampling temperature for LLM responses (default: 1)
TEMPERATURE=1

# Browser used by Selenium for web scraping (default: chrome)
# Options: chrome, firefox, safari
# Note: chromedriver-autoinstaller will automatically download the correct
# chromedriver version when using chrome. For Docker, chromium and
# chromium-driver are pre-installed in the image.
USE_WEB_BROWSER=chrome

# Custom user agent string for web scraping
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_4) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/83.0.4103.97 Safari/537.36

# Memory backend (default: local)
MEMORY_BACKEND=local
